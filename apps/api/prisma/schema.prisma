generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Post {
  id           String   @id @default(cuid())
  title        String   @unique
  category     String
  organization String
  description  String
  date         String
  deadline     String?
  location     String?
  sourceUrl    String?
  image        String
  color        String   @default("yellow")
  tag          String
  featured     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
  @@index([createdAt])
}

model AdminUser {
  id             String   @id @default(cuid())
  username       String   @unique
  displayName    String
  email          String   @unique
  passwordHash   String
  sessionVersion Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}